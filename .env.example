# Copy this file to .env.local. Never commit .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOONSHOT_API_KEY=

# A cost-conscious default for high-volume summarization.
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
MOONSHOT_MODEL=kimi-k3

# Optional. When empty, OpenHistory Focus uses
# ~/Library/Application Support/OpenHistory Focus/activity-data. Upstream OpenHistory's
# OPENHISTORY_DATA_DIR is intentionally ignored so the fork never reads upstream history.
OPENHISTORY_FOCUS_DATA_DIR=

# Set to 1 only when deliberately adopting an existing, nonempty custom activity-data directory.
OPENHISTORY_FOCUS_ADOPT_DATA_DIR=

# Optional stable loopback port for read-only local MCP agent access (upstream uses 47831).
OPENHISTORY_FOCUS_MCP_PORT=47841

# Optional local packaging identity from `security find-identity -v -p codesigning`.
# OPENHISTORY_FOCUS_SIGN_IDENTITY=Apple Development: Your Name (TEAMID)
